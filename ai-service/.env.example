# PostgreSQL connection (replace the example password)
SUPPORTFLOW_AI_DATABASE_URL=postgresql://supportflow_ai:replace-me@127.0.0.1:5432/ai_db

SUPPORTFLOW_AI_APP_NAME=supportflow-ai
SUPPORTFLOW_AI_DEBUG=false
SUPPORTFLOW_AI_API_PREFIX=/api
# Distinct internal credentials; use the same value on AI and the corresponding Java caller.
SUPPORTFLOW_AI_GATEWAY_SECRET=
SUPPORTFLOW_AI_CUSTOMER_SECRET=
SUPPORTFLOW_AI_OPS_SECRET=
SUPPORTFLOW_AI_TENANT_SECRET=
# B1 内部持久化接收入口，尚未切换现有客服触发/结果回写；默认关闭。
# 启用前运行权威迁移与角色配置，签名复用独立 CUSTOMER_SECRET，不使用用户 JWT。
SUPPORTFLOW_AI_RUNTIME_API_ENABLED=false
SUPPORTFLOW_AI_CUSTOMER_RUNTIME_URL=http://127.0.0.1:9093

SUPPORTFLOW_AI_LOG_LEVEL=INFO
# 是否打印 AI 调用的完整入参/出参（排障用；生产可置 false 降噪）
SUPPORTFLOW_AI_LLM_LOG_PAYLOAD=false
# 不用改成 qwen / deepseek：只要下面任一密钥有值，质检就会自动使用真实模型；
# 租户在「智能机器人 → 模型选择」里选的模型优先级更高。
SUPPORTFLOW_AI_LLM_DEFAULT_PROVIDER=
SUPPORTFLOW_AI_LLM_DEFAULT_MODEL=
SUPPORTFLOW_AI_LLM_TIMEOUT=30
SUPPORTFLOW_AI_QWEN_API_KEY=
SUPPORTFLOW_AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORTFLOW_AI_QWEN_MODEL=qwen-plus
SUPPORTFLOW_AI_DEEPSEEK_API_KEY=
SUPPORTFLOW_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
SUPPORTFLOW_AI_DEEPSEEK_MODEL=deepseek-chat
SUPPORTFLOW_AI_REDIS_URL=redis://localhost:6379/0
SUPPORTFLOW_AI_KAFKA_BOOTSTRAP=localhost:9092

# 知识库向量化（第 20 篇）：留空则用本地兜底向量（只能字面匹配，建议配上）
# 千问的 OpenAI 兼容接口和 LLM 用同一个 key
SUPPORTFLOW_AI_EMBEDDING_PROVIDER=qwen
SUPPORTFLOW_AI_EMBEDDING_API_KEY=
SUPPORTFLOW_AI_EMBEDDING_MODEL=text-embedding-v3
# 切片参数（字符数 / 重叠字符数）
SUPPORTFLOW_AI_KB_CHUNK_SIZE=600
SUPPORTFLOW_AI_KB_CHUNK_OVERLAP=80
# 知识库所在库（留空则从 ai_db 推导成 customer_db）
SUPPORTFLOW_AI_KB_DATABASE_URL=postgresql://supportflow_kb:replace-me@127.0.0.1:5432/customer_db

# 视觉模型（客户发图时用它做 OCR / 截图判读，默认 qwen-vl-plus；和文本模型共用同一个千问密钥）
# SUPPORTFLOW_AI_QWEN_VL_MODEL=qwen-vl-plus
# 一条消息最多看几张图 / 单张 data URL 上限（MB）：前端也卡 3 张，别只改一边
SUPPORTFLOW_AI_VISION_MAX_IMAGES=3
SUPPORTFLOW_AI_VISION_MAX_IMAGE_MB=6

# 阿里云智能语音交互（NLS）：400 热线录音转写（ASR）+ IVR 播报合成（TTS）
# 注意：这套和上面的千问（DashScope）不是同一个产品，需要单独开通「智能语音交互」
# 并拿到 AppKey；AccessKey 建议用只授权 NLS 的 RAM 子账号。
# 不开（或留空）时：录音不转写、IVR 回退成播报文本，功能不报错。
SUPPORTFLOW_AI_SPEECH_ENABLED=false
SUPPORTFLOW_AI_SPEECH_APP_KEY=
SUPPORTFLOW_AI_SPEECH_ACCESS_KEY_ID=
SUPPORTFLOW_AI_SPEECH_ACCESS_KEY_SECRET=
SUPPORTFLOW_AI_SPEECH_REGION=cn-shanghai
# TTS 音色：默认知祥（磁性男声）；可选 aixia / aijia 等，见阿里云音色列表
SUPPORTFLOW_AI_SPEECH_TTS_VOICE=zhixiang
SUPPORTFLOW_AI_SPEECH_TTS_FORMAT=wav
SUPPORTFLOW_AI_SPEECH_TTS_SAMPLE_RATE=16000
# 单条音频上限（MB）与单段播报文案上限（字）
SUPPORTFLOW_AI_SPEECH_MAX_AUDIO_MB=10
SUPPORTFLOW_AI_SPEECH_MAX_TEXT_CHARS=500
