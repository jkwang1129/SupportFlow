<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>io.supportflow</groupId>
    <artifactId>supportflow-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SupportFlow Backend</name>
    <description>SupportFlow 智能客服平台 · 后端微服务</description>

    <modules>
        <module>supportflow-common</module>
        <module>supportflow-gateway</module>
        <module>supportflow-user-service</module>
        <module>supportflow-tenant-service</module>
        <module>supportflow-customer-service</module>
        <module>supportflow-realtime-service</module>
        <module>supportflow-billing-service</module>
        <module>supportflow-ops-service</module>
    </modules>

    <properties>
        <!--
          ScopedValue（JEP 506）在 JDK 25 才转正；21~24 属于预览 API，需要 enable-preview，
          生产环境不适合开预览特性。这里把编译目标提到 25，用它替代 ThreadLocal 传登录态。
        -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <!-- 与各服务 mybatis-plus 3.5.17 传递进来的 mybatis 保持一致（common 的类型处理器编译期要用） -->
        <mybatis.version>3.5.19</mybatis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM：网关等组件版本统一管理 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
